---
import '../styles/dashboard.scss';
import SidePanel from '../components/Sidebar.astro';
import MainPanel from '../components/MainPanel.astro';

// Placeholder server fragment (will be replaced dynamically)
const defaultMsg = "<p>Welcome...</p>";
---

<div class="dashboard">
  <SidePanel activeTab="orders" />
  <MainPanel fragment={defaultMsg} />
</div>
<script>
  interface Order {
    id: number;
    name: string;
    contact: string;
    address: string;
    paymentMethod: string;
    total: number;
    status: string;
  }
  
  const mainPanel = document.querySelector<HTMLDivElement>(".main-panel");
  if (!mainPanel) throw new Error("Main panel not found");
  
  // Render a single order
  const renderOrder = (order: Order) => {
    // Avoid duplicate rendering if already present
    if (mainPanel.querySelector(`.order-fragment[data-order-id="${order.id}"]`)) return;
  
    const div = document.createElement("div");
    div.className = "order-fragment";
    div.dataset.orderId = order.id.toString();
  
    div.innerHTML = `
      <h3>Order #${order.id}</h3>
      <p><strong>Name:</strong> ${order.name}</p>
      <p><strong>Contact:</strong> ${order.contact}</p>
      <p><strong>Address:</strong> ${order.address}</p>
      <p><strong>Payment Method:</strong> ${order.paymentMethod}</p>
      <p><strong>Total:</strong> $${order.total.toFixed(2)}</p>
      <p><strong>Status:</strong> ${order.status}</p>
      <button class="confirm-btn">Confirm Order</button>
    `;
  
    const btn = div.querySelector<HTMLButtonElement>(".confirm-btn");
    if (btn) {
      btn.addEventListener("click", () => {
        ws.send(
          JSON.stringify({
            type: "confirm_order",
            order_id: order.id,
            status: "confirmed",
          })
        );
        // Update status locally for instant UI feedback
        const statusP = div.querySelector("p:nth-of-type(6)");
        if (statusP) statusP.textContent = "Status: confirmed";
        btn.disabled = true;
      });
    }
  
    mainPanel.appendChild(div);
  };
  
  // Load all orders from backend
  const loadOrders = async () => {
    try {
      const res = await fetch("/api/orders");
      if (!res.ok) throw new Error(`HTTP error: ${res.status}`);
      const orders: Order[] = await res.json();
      mainPanel.innerHTML = ""; // clear previous
      if (Array.isArray(orders)) {
        orders.forEach(renderOrder);
      } else {
        console.warn("No orders to render");
      }
    } catch (err) {
      console.error("Failed to load orders:", err);
      mainPanel.innerHTML = "<p>Failed to load orders. Check console.</p>";
    }
  };
  
  // WebSocket
  const ws = new WebSocket("ws://localhost:8000/ws/orders");
  
  ws.addEventListener("open", () => {
    console.log("WS connected");
  });
  
  ws.addEventListener("message", (event) => {
    try {
      const msg = JSON.parse(event.data);
  
      if (msg.type === "new_order") {
        renderOrder(msg.order as Order);
      }
  
      if (msg.type === "update_order") {
        const div = mainPanel.querySelector<HTMLDivElement>(
          `.order-fragment[data-order-id="${msg.order_id}"]`
        );
        if (div) {
          if (msg.status === "confirmed") {
            // Remove confirmed order from dashboard
            div.remove();
          } else {
            // Update status text for non-confirmed updates (optional)
            const statusSpan = div.querySelector<HTMLSpanElement>(".status");
            if (statusSpan) statusSpan.textContent = msg.status;
          }
        }
      }
    } catch (err) {
      console.error("Failed to handle WS message:", err);
    }
  });
  
  // Initial load
  loadOrders();
  </script>


