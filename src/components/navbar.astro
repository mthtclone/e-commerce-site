---
import Search from '@lucide/astro/icons/search';
import ShoppingCart from '@lucide/astro/icons/shopping-cart';

type PageUrl = {
	url: string;	
}

const PageGlob = import.meta.glob('../pages/*.astro', { eager: true }); 
const PagesMap: Record<string, { url: string }> = Object.values(PageGlob)
  .map((mod: any) => ({ url: mod.url || '' }))
  .filter(page => page.url)
  .reduce((acc, page) => {
    acc[page.url] = page; // key = URL
    return acc;
  }, {} as Record<string, { url: string }>);

console.log(PagesMap);

const UpdatePage = PagesMap['/update'];   
const addToCartPage = PagesMap['/checkout'];

---

<nav class="navbar">
  <div class="navbar__container">
    <!-- Logo -->
    <div class="navbar__logo">
      <div class="logo-placeholder">
        <a href="/" aria-label="Homepage">
          <img src="/img/homelab_logo.png" alt="Homelab" />
        </a>
      </div>
    </div>

    <!-- Menu -->
    <ul class="navbar__menu">
      <li><a href="/">Home</a></li>
      <li><a href="#">About</a></li>
      <li><a href="#">Contact</a></li>
    </ul>

    <!-- Icons -->
    <div class="navbar__icons">
      <!-- Search -->
      <div class="navbar__search">
        <form action="#" method="get" class="search-form">
          <input
            type="search"
            class="search-input"
            name="q"
            placeholder="__"
            aria-label="Search"
          />
          <button type="submit" class="search-button" aria-label="search">
            <Search />
          </button>
        </form>
      </div>
      {UpdatePage && (
      <button class="icon-btn" aria-label="Mail">
        <a href={UpdatePage.url}>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell-icon lucide-bell"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/></svg>
        </a>
      </button>
      )}

     {addToCartPage && (
      <button class="icon-btn" aria-label="Cart">
       <a href={addToCartPage.url}> <ShoppingCart /> </a>
      </button>
      )}
    </div>
  </div>
</nav>